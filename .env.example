# ==========================================
# 环境变量配置模板 (复制后命名为 .env.development 或 .env.production)
# ==========================================

# 1. 本地开发环境 (.env.development)
# 提示: 本地开发时建议 VITE_API_HOST 留空，使用 Vite 代理转发避免 CORS 跨域问题
VITE_API_HOST=
VITE_API_BASE_URL=/admin-api
# Vite 代理目标 (支持本地 http://192.168.1.2:48080 或远程 https://qxj.jiancan.fun)
VITE_PROXY_TARGET=http://192.168.1.2:48080

# 2. 生产构建上线环境 (.env.production)
# VITE_API_HOST=https://qxj.jiancan.fun
# VITE_API_BASE_URL=/admin-api
